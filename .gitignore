# Local and generated content
/tmp/*
!/tmp/.gitkeep
/trash/*
!/trash/.gitkeep
/out/*
!/out/.gitkeep

# Dataset contents; retain documentation and acquisition material
/data/*
!/data/README.md
!/data/manifest.*
!/data/scripts/
!/data/scripts/**

# Local environments and secrets
.venv/
.env
.env.*
!.env.example

# Generated and system files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
